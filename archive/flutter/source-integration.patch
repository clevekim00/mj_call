+/// Shares the app's play-and-record session so speech does not end call capture.
+private final class CallAssistSpeech: NSObject, AVSpeechSynthesizerDelegate {
+  private let synthesizer = AVSpeechSynthesizer()
+  private var pending: FlutterResult?
+  private var utterance: AVSpeechUtterance?
+
+  override init() {
+    super.init()
+    synthesizer.delegate = self
+    synthesizer.usesApplicationAudioSession = true
+  }
+
+  func speak(_ text: String, result: @escaping FlutterResult) {
+    stop()
+    guard let voice = AVSpeechSynthesisVoice(language: "ko-KR") else {
+      result(FlutterError(code: "voice_missing", message: "Install a Korean voice.", details: nil))
+      return
+    }
+    do {
+      let session = AVAudioSession.sharedInstance()
+      // Avoid changing the route/category while a recorder is already running.
+      if session.category != .playAndRecord {
+        try session.setCategory(.playAndRecord, mode: .default, options: [.defaultToSpeaker])
+      }
+      try session.setActive(true)
+      let next = AVSpeechUtterance(string: text)
+      next.voice = voice
+      next.rate = 0.42
+      next.volume = 1
+      utterance = next
+      pending = result
+      synthesizer.speak(next)
+    } catch {
+      result(FlutterError(code: "speech_failed", message: "Could not play speech.", details: nil))
+    }
+  }
+
+  func stop() {
+    let result = pending
+    pending = nil
+    utterance = nil
+    synthesizer.stopSpeaking(at: .immediate)
+    result?(nil)
+  }
+
+  func speechSynthesizer(_ synthesizer: AVSpeechSynthesizer,
+                         didFinish utterance: AVSpeechUtterance) {
+    finish(utterance)
+  }
+  func speechSynthesizer(_ synthesizer: AVSpeechSynthesizer,
+                         didCancel utterance: AVSpeechUtterance) {
+    finish(utterance)
+  }
+  private func finish(_ finished: AVSpeechUtterance) {
+    guard finished === utterance else { return }
+    let result = pending
+    pending = nil
+    utterance = nil
+    result?(nil)
+  }
+}
